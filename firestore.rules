rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /progress/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }
      allow read, delete: if isOwner();
      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly(['version', 'records'])
        && request.resource.data.keys().hasAll(['version', 'records'])
        && request.resource.data.version == 2
        && request.resource.data.records is map
        && request.resource.data.records.size() <= 150;
    }
  }
}
